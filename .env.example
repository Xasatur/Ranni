# Copy to .env; never commit .env or share tokens
DISCORD_BOT_TOKEN=REPLACE_WITH_NEW_RANNI_DEV_TOKEN
OPENAI_API_KEY=REPLACE_WITH_NEW_OPENAI_API_KEY
RANNI_OWNER_DISCORD_ID=REPLACE_WITH_NUMERIC_DISCORD_ID
RANNI_PC_NAME=Gaming Desktop
# Use local LAN IP when testing at home, e.g. http://192.168.0.X:8123
HOME_ASSISTANT_URL=http://YOUR_HOME_ASSISTANT_IP:8123
# Home Assistant profile -> Security -> Long-lived access tokens
HOME_ASSISTANT_TOKEN=REPLACE_WITH_NEW_LONG_LIVED_ACCESS_TOKEN
# Entity ID of the Ping (ICMP) binary sensor
HOME_ASSISTANT_PC_ENTITY=binary_sensor.YOUR_GAMING_PC_PING
